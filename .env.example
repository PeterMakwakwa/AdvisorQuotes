# Copy to .env (not committed) and adjust. Read by docker compose.
POSTGRES_DB=advisor_quotes
POSTGRES_USER=advisor_quotes
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# Port the API container is published on
API_PORT=8080

# Port the UI container is published on
WEB_PORT=3000

# Tracing. By default spans are written to the API's console (no extra services needed).
# To view traces in Jaeger instead (http://localhost:16686), uncomment the next three lines; COMPOSE_PROFILES makes a
# plain `docker compose up` start Jaeger as well (same as --profile observability):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# COMPOSE_PROFILES=observability
# TELEMETRY_CONSOLE_EXPORTER=false

# Metrics. Set to true to print the business metrics (quotes.*) to the API console every N seconds.
TELEMETRY_CONSOLE_METRICS_EXPORTER=false
TELEMETRY_METRICS_EXPORT_INTERVAL_SECONDS=15

# Log format: json (default outside Development, for log stores) or text (easier to read in a terminal)
LOG_FORMAT=json

<?xml version="1.0" encoding="utf-8"?>
<!-- The grate scripts for the quotes database, shown in Visual Studio as a project. Nothing is compiled: grate deploys the
     scripts (the db-migrations service in docker-compose.yml, or scripts/migrate.ps1).
     The Visual Studio imports are conditional so dotnet CLI tools (build, format, list package) can load the solution. -->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>2a0186fd-d3be-49e7-86cd-ba3e7dde6cd3</ProjectGuid>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <CodeSharingPath>$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\CodeSharing</CodeSharingPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <Import Project="$(CodeSharingPath)\Microsoft.CodeSharing.Common.Default.props" Condition="Exists('$(CodeSharingPath)\Microsoft.CodeSharing.Common.Default.props')" />
  <Import Project="$(CodeSharingPath)\Microsoft.CodeSharing.Common.props" Condition="Exists('$(CodeSharingPath)\Microsoft.CodeSharing.Common.props')" />
  <PropertyGroup />
  <Import Project="dbQuotes.projitems" Label="Shared" />
  <Import Project="$(CodeSharingPath)\Microsoft.CodeSharing.CSharp.targets" Condition="Exists('$(CodeSharingPath)\Microsoft.CodeSharing.CSharp.targets')" />
</Project>

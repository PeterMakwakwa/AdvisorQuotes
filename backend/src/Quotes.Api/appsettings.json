{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Logging": {
    "Format": ""
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "ServiceName": "advisor-quotes-api",
    "ConsoleExporter": true,
    "ConsoleMetricsExporter": false,
    "OtlpMetrics": false,
    "MetricsExportIntervalSeconds": 15
  },
  "OpenApi": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:01:00",
    "RequireForwardedHeaders": true
  },
  "Database": {
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:05"
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 20,
    "LeaseDuration": "00:01:00",
    "InitialRetryDelay": "00:00:05",
    "MaxRetryDelay": "00:05:00",
    "BacklogAgeWarning": "00:05:00"
  },
  "Maintenance": {
    "Enabled": true,
    "Interval": "01:00:00",
    "ExpiredIdempotencyKeyRetention": "1.00:00:00",
    "ProcessedOutboxRetention": "7.00:00:00",
    "DeleteBatchSize": 5000
  },
  "Idempotency": {
    "KeyLifetime": "1.00:00:00",
    "FingerprintWindow": "00:10:00"
  },
  "Pricing": {
    "Version": "2026.1",
    "Currency": "ZAR",
    "TimeZone": "Africa/Johannesburg",
    "SmokerLoading": 1.50,
    "Products": [
      {
        "ProductCode": "TERM_LIFE",
        "MonthlyRatePerThousand": 0.30,
        "MinCoverAmount": 100000,
        "MaxCoverAmount": 10000000,
        "MinTermYears": 5,
        "MaxTermYears": 30,
        "MaxAgeAtExpiry": 75
      },
      {
        "ProductCode": "SERIOUS_ILLNESS",
        "MonthlyRatePerThousand": 0.55,
        "MinCoverAmount": 50000,
        "MaxCoverAmount": 5000000,
        "MinTermYears": 5,
        "MaxTermYears": 25,
        "MaxAgeAtExpiry": 70
      }
    ],
    "AgeBands": [
      { "From": 18, "To": 30, "Factor": 0.80 },
      { "From": 31, "To": 40, "Factor": 1.00 },
      { "From": 41, "To": 50, "Factor": 1.60 },
      { "From": 51, "To": 60, "Factor": 2.60 },
      { "From": 61, "To": 65, "Factor": 4.00 }
    ],
    "TermBands": [
      { "From": 5, "To": 10, "Factor": 0.95 },
      { "From": 11, "To": 20, "Factor": 1.00 },
      { "From": 21, "To": 30, "Factor": 1.10 }
    ]
  }
}
